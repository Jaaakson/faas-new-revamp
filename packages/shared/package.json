{
  "name": "@fvas/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Types generated from the FastAPI OpenAPI schema. Do not edit api.d.ts by hand.",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../openapi.json -o ./src/api.d.ts",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.7.2"
  }
}
