# ==============================================================================
# Fvas — environment configuration
#
# Copy to .env and fill in. Every variable here is validated at API startup by
# pydantic-settings; a missing or malformed value exits the process immediately
# rather than serving broken requests.
#
# NEVER commit a real .env file.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
ENVIRONMENT=development                 # development | staging | production
DEBUG=true                              # must be false outside development
APP_NAME=Fvas
API_V1_PREFIX=/v1
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                         # json | console (console for local dev)

# ------------------------------------------------------------------------------
# Database
# Requires the pgvector extension — use the pgvector/pgvector:pg16 image.
# ------------------------------------------------------------------------------
# Host-oriented, on purpose. docker-compose.yml overrides both of these with
# the service names (`postgres`, `redis`) for containers, so the values here are
# the ones used by anything run *on the host* — alembic, pytest, a natively-run
# uvicorn. Service names do not resolve outside the Compose network, so putting
# them here would break every host-run tool with a DNS error.
# Match the ports to POSTGRES_PORT / REDIS_PORT below if you change them.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fvas

# Host ports for the Compose stack. Change these — not DATABASE_URL — if a
# locally installed PostgreSQL or Redis already owns the default. Docker
# reports the mapping as bound even when it loses the race for the port, so
# a collision shows up later as a confusing authentication failure against
# the wrong database.
API_PORT=8001
WEB_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false                     # log every SQL statement — dev only

# ------------------------------------------------------------------------------
# Redis — rate limiting, idempotency cache, refresh-token denylist
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Security
# Generate secrets with: openssl rand -hex 32
# Rotating JWT_SECRET_KEY invalidates every active session.
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=dev-only-insecure-key-replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_HOURS=24
INVITATION_EXPIRE_DAYS=7

ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536                # KiB — 64 MiB
ARGON2_PARALLELISM=4

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Comma-separated allowlist. NEVER use "*" — credentials are sent to the console origin.
CORS_ORIGINS=http://localhost:3001
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false                     # must be true outside development

# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
# Face engine
#
# `fake` is deterministic, needs no model download, and is what CI runs — it
# keeps the suite at seconds instead of minutes. It is the default so that
# `docker compose up` works immediately on a clean clone.
#
# For the real pipeline:
#   1. FACE_ENGINE=insightface
#   2. rebuild the API image with the optional extra (uv sync --extra face)
#   3. first start downloads ~600 MB of models into the `models` volume
#
# Production MUST use insightface — the app refuses to start with `fake` set in
# a production environment, because a fake engine accepts every face.
# ------------------------------------------------------------------------------
FACE_ENGINE=fake                        # fake | insightface
FACE_MODEL_NAME=buffalo_l

# 320, not 640. Measured at ~2.5x cheaper (121 ms vs 303 ms detection) for
# recall the 112 px inter-ocular gate discards anyway — docs/14-phase-0-spike.md.
FACE_DET_SIZE=320
FACE_DET_THRESHOLD=0.5

# NEVER 0. ONNX Runtime reads 0 as "every visible core", and a container sees
# the host's cores regardless of its CPU quota — that oversubscription measured
# 5x slower (p95 1674 ms vs 331 ms). Scale with workers, not with threads.
ONNX_INTRA_OP_THREADS=2

# Default matching threshold. Calibrated on 8,559 genuine and 500,000 impostor
# LFW pairs: FAR 8e-6, FRR 3.06%, TAR 97.36% @ FAR 1e-4. Per-organization
# overrides live in org_settings. Re-calibrate before changing.
DEFAULT_MATCH_THRESHOLD=0.38
# Higher than the match threshold on purpose: a duplicate false positive blocks
# a legitimate user from onboarding at all.
DEFAULT_DUPLICATE_THRESHOLD=0.60

# Quality gates. These are estimates — the Phase 0 spike calibrated the matching
# threshold, not these. Next thing to measure.
MIN_FACE_SIZE_PX=112
MIN_SHARPNESS=0.35
MIN_BRIGHTNESS=0.25
MAX_BRIGHTNESS=0.85
MAX_YAW_DEGREES=25
MAX_PITCH_DEGREES=20
MAX_ROLL_DEGREES=20

# ------------------------------------------------------------------------------
# Uploads
# ------------------------------------------------------------------------------
MAX_IMAGE_SIZE_MB=8
MAX_IMAGE_DIMENSION=4096
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
MAX_ENROLLMENT_IMAGES=5

# ------------------------------------------------------------------------------
# Rate limiting (requests per second unless noted)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_VERIFICATION=10
RATE_LIMIT_ENROLLMENT=2
RATE_LIMIT_READ=20
RATE_LIMIT_AUTH_PER_MINUTE=5

# ------------------------------------------------------------------------------
# Quotas — free plan defaults; paid plans are resolved from the organization row
# ------------------------------------------------------------------------------
FREE_PLAN_VERIFICATIONS=1000
FREE_PLAN_SUBJECTS=500
FREE_PLAN_MEMBERS=2
FREE_PLAN_LOG_RETENTION_DAYS=7

# ------------------------------------------------------------------------------
# Object storage — only used when an organization opts into image retention.
# Leave blank to disable retention entirely.
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-southeast-1

# ------------------------------------------------------------------------------
# Email — transactional only (verification, reset, invitations)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@fvas.io
SMTP_FROM_NAME=Fvas
SMTP_TLS=true

# ------------------------------------------------------------------------------
# Webhooks
# ------------------------------------------------------------------------------
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_DISABLE_AFTER_FAILURES=20

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_ENABLED=true

# ------------------------------------------------------------------------------
# Frontend (apps/web)
# NEXT_PUBLIC_* values are embedded in the client bundle — never put a secret here.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8001

# Server-side only, used by the Next.js BFF route handlers. Under Docker the
# browser reaches the API on a published port while the web container reaches
# it by service name; using the browser's URL server-side resolves to the web
# container itself. Compose sets this to http://api:8000. Leave it unset when
# running both apps directly on the host.
API_INTERNAL_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Fvas
NEXT_PUBLIC_ENABLE_PLAYGROUND=true